#!/usr/bin/env python3
"""Read-only snapshot of the dispatch relay.

Shows which agent sessions are live (hold their presence lock), whether each is
actually listening (holds a message watch), their channel subscriptions, and how
many unread messages sit in each inbox — plus any orphaned inboxes (messages
whose owner is gone). Touches nothing.

Live and listening are separate facts. A session with no watch armed collects
mail it will not notice until its operator next types, and looks healthy from
every other angle.

    bin/dispatch-status            # default relay dir
    MCP_DISPATCH_DIR=... bin/dispatch-status
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import dispatch_common as common  # noqa: E402
import dispatch_fs  # noqa: E402


def _pending(inbox: Path) -> int:
    # Shared with the supervisor and the digest, so "unread: 4" here means the
    # same four messages they would act on. This used to count expired mail.
    return dispatch_fs.count_pending(inbox)


def main() -> int:
    relay = common.dispatch_dir(common.load_config())
    if not relay.is_dir():
        print(f"No relay yet at {relay}")
        print("→ no dispatch-enabled session has started. Open a Claude Code window.")
        return 0

    presence = relay / ".presence"
    live: dict[str, tuple[dict, Path]] = {}
    for pf in sorted(presence.glob("*.json")):
        try:
            data = json.loads(pf.read_text())
        except (json.JSONDecodeError, OSError):
            continue
        if common.flock_held(pf):
            live[data.get("agent_id", pf.stem)] = (data, pf)

    print(f"relay: {relay}")
    print(f"live agents: {len(live)}")
    deaf: list[tuple[str, int]] = []
    for aid, (data, pf) in live.items():
        chans = data.get("channels") or []
        chan_s = "  " + " ".join(f"#{c}" for c in chans) if chans else ""
        pending = _pending(relay / aid)
        armed = common.armed_for(data, pf)
        mark = {True: "", False: "  NOT LISTENING", None: "  listening:?"}[armed]
        print(f"  {aid}  (pid {data.get('pid')})  unread:{pending}{mark}{chan_s}")
        if armed is False:
            deaf.append((aid, pending))

    if deaf:
        # Live and addressable and asleep at the same time — the state that reads
        # as healthy from every other angle, and the one that quietly swallows
        # mail. Waiting on a reply from one of these is waiting on a human.
        print("live but not listening (no message watch armed):")
        for aid, count in deaf:
            print(f"  {aid}  unread:{count}")
        print("  → these wake when their operator next types, not when mail lands.")

    # Orphaned inboxes: a dir with messages but no live owner.
    live_ids = set(live)
    orphans = []
    for d in sorted(relay.iterdir()):
        if d.is_dir() and not d.name.startswith(".") and d.name not in live_ids:
            count = _pending(d)
            if count:
                orphans.append((d.name, count))
    if orphans:
        print("orphaned inboxes (owner gone, messages remain):")
        for name, count in orphans:
            print(f"  {name}  unread:{count}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
